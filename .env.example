TELEGRAM_API_ID=
TELEGRAM_API_HASH=
BOT_TOKEN=
GEMINI_API_KEY=
CHANNELS=@channel1,@channel2
BUFFER_SIZE=100
MAX_CONTEXT_MESSAGES=50
# Cooldown in seconds between analysis commands (/summary, /threat, /factcheck); 0 disables
RATE_LIMIT_SECONDS=15
DATABASE_URL=
# Path to Aiven CA certificate (download from Aiven console); enables full TLS verification
DATABASE_CA_CERT=
# "require" (default) or "disable" for a local/sidecar Postgres without TLS
DATABASE_SSL=require
RETENTION_DAYS=
PRUNE_INTERVAL_HOURS=
OWNER_ID=
# Optional: Telethon session string (alternative to session.session file)
SESSION_STRING=
# Scheduled digests, Asia/Ho_Chi_Minh times; empty disables
HN_DIGEST_TIMES=08:30,20:00
PRESS_DIGEST_TIMES=07:00
# Proactive alerts: push owner when a live message contains any keyword; empty disables
ALERT_KEYWORDS=nuclear,mobilization,martial law,invasion,ceasefire,airstrike,breaking