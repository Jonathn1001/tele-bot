TELEGRAM_API_ID=
TELEGRAM_API_HASH=
BOT_TOKEN=
GEMINI_API_KEY=
CHANNELS=@channel1,@channel2
BUFFER_SIZE=100
MAX_CONTEXT_MESSAGES=50
# Cooldown in seconds between analysis commands (/summary, /threat, /factcheck); 0 disables
RATE_LIMIT_SECONDS=15
DATABASE_URL=
# Path to Aiven CA certificate (download from Aiven console); enables full TLS verification
DATABASE_CA_CERT=
# "require" (default) or "disable" for a local/sidecar Postgres without TLS
DATABASE_SSL=require
RETENTION_DAYS=
PRUNE_INTERVAL_HOURS=
OWNER_ID=
# Optional: Telethon session string (alternative to session.session file)
SESSION_STRING=
# Scheduled digests, Asia/Ho_Chi_Minh times; empty disables
HN_DIGEST_TIMES=12:30
PRESS_DIGEST_TIMES=18:30
# Proactive alerts: push owner when a live message contains any keyword; empty disables
ALERT_KEYWORDS=nuclear,mobilization,martial law,invasion,ceasefire,airstrike,breaking
# --- Weekly review (Notion → Gemini → Telegram); all optional, empty disables ---
# Notion internal integration token (notion.so/my-integrations)
NOTION_API_KEY=
# Parent page holding the weekly to-do pages (📅 Weekly To-do Lists)
NOTION_TODO_PARENT_ID=3a435e09628b81758610e824be221ded
# Sunday review push time, Asia/Ho_Chi_Minh; empty disables the schedule
WEEKLY_REVIEW_TIME=19:00
# false disables cloning next week's page (review still runs)
WEEKLY_AUTOCREATE=true
# false disables writing the Sunday review back onto its Notion week page (Telegram push still runs)
WEEKLY_WRITEBACK=true
# Optional: clone this fixed page each week instead of the current-week page
NOTION_TEMPLATE_PAGE_ID=